# ── SQL Server ────────────────────────────────────────────────
# Requisitos: mínimo 8 caracteres, mayúsculas, minúsculas, números y símbolo
# Ejemplo: MyPassword@2024!
SQL_SA_PASSWORD=

# ── Azure Service Bus ─────────────────────────────────────────
# Formato: Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...
# Dejar vacío en desarrollo local
SERVICE_BUS_CONNECTION_STRING=

# ── Ambiente ──────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development