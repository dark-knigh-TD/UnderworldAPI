# ── SQL Server ────────────────────────────────────────────────
# Requisitos: mínimo 8 caracteres, mayúsculas, minúsculas, números y símbolo
# Ejemplo: MyPassword@2024!
SQL_SA_PASSWORD=Underworld@2026!

# Connection Strings completas
SALES_DB_CONNECTION_STRING=Server=sqlserver,1433;Database=UnderworldDB;User Id=sa;Password=Underworld@2026!;TrustServerCertificate=True;
PURCHASES_DB_CONNECTION_STRING=Server=sqlserver,1433;Database=UnderworldDB;User Id=sa;Password=Underworld@2026!;TrustServerCertificate=True;

# ── Azure Service Bus ─────────────────────────────────────────
# Formato: Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...
# Dejar vacío en desarrollo local
SERVICE_BUS_CONNECTION_STRING=

# ── Ambiente ──────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development